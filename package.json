{
  "name": "finance-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test \"tests/**/*.test.js\"",
    "build": "vite build",
    "build:android": "vite build --mode android",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "deploy": "gh-pages -d dist",
    "cap:copy": "cap copy android",
    "cap:sync": "npm run build:android && cap sync android",
    "cap:open:android": "cap open android",
    "cap:assets": "capacitor-assets generate --android",
    "android:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/hind-siliguri": "^5.0.0",
    "chart.js": "^4.4.0",
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.1.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.1"
  }
}
